# Environment Configuration Template for Zero-Trust API Gateway

# Gateway Services Ports & Hosts
CONTROL_PLANE_PORT=3002
CONTROL_PLANE_HOST=0.0.0.0
DATA_PLANE_PORT=3003
DATA_PLANE_HOST=0.0.0.0

# Control Plane URL (polled by Data Plane)
CONTROL_PLANE_URL=http://localhost:3002
CONFIG_POLL_INTERVAL_SECONDS=4

# Storage & Infrastructure
# MongoDB runs on host (localhost:27017 for local uv run, host.docker.internal:27017 for Docker)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=zero_trust_gateway

# Redis (Feature store & rolling windows)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# SpiceDB (ReBAC store)
SPICEDB_GRPC_ENDPOINT=localhost:50051
SPICEDB_PRESHARED_KEY=secret_preshared_key
SPICEDB_INSECURE=true

# Postgres (Backing store for SpiceDB in Docker Compose)
POSTGRES_USER=spicedb
POSTGRES_PASSWORD=spicedb_password
POSTGRES_DB=spicedb

# Anomaly Model & Trust Decay Parameters
MODEL_PATH=models/isolation_forest.joblib
EXPLAINER_PATH=models/shap_explainer.joblib
TRUST_HALF_LIFE_SECONDS=300
TRUST_ANOMALY_WEIGHT=0.35
BAND_THRESHOLD_NARROW=0.85
BAND_THRESHOLD_STEP_UP=0.60
BAND_THRESHOLD_DENY=0.40
