FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH="/app"

# Copy workspace specification and source code
COPY pyproject.toml uv.lock ./
COPY packages/ ./packages/
COPY services/ ./services/
COPY models/ ./models/
COPY scripts/ ./scripts/
COPY schema.zed ./

# Install all workspace dependencies
RUN uv sync --frozen --no-dev

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 3003

# Model inference is CPU-bound: raise DATA_PLANE_WORKERS on hosts with spare cores (on a 2-vCPU host
# shared with Redis/SpiceDB, one worker measured best).
ENV DATA_PLANE_WORKERS=1
CMD ["sh", "-c", "uvicorn data_plane.main:app --host 0.0.0.0 --port 3003 --workers ${DATA_PLANE_WORKERS}"]
